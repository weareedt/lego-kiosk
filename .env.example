# Optional. Where the reveal QR code points. Leave unset to use this deployment's
# own /match page (recommended). Query params are appended:
#   ?s=<session id>&c=<character id>&n=<first name>&t=<unix time>
# VITE_QR_BASE_URL=https://lego-kiosk.vercel.app/match

# Usage stats (/stats) are stored in Firebase (Realtime Database). Set this to
# the service account key from the Firebase console (Project settings → Service
# accounts → Generate new private key): the whole JSON file, or base64 of it.
# Locally, leave it unset to use an in-memory store.
# FIREBASE_SERVICE_ACCOUNT=
# Optional: another database than the lego-kiosk project's own (server/usage.ts).
# FIREBASE_DATABASE_URL=
# Optional: require this key to view /stats.
# STATS_KEY=
