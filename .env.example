# Optional. Where the reveal QR code points. Leave unset to use this deployment's
# own /match page (recommended). Query params are appended:
#   ?s=<session id>&c=<character id>&n=<first name>&t=<unix time>
# VITE_QR_BASE_URL=https://lego-kiosk.vercel.app/match

# Usage stats (/stats). On Vercel these come from the connected Upstash Redis
# database (Storage tab). Locally, leave them unset to use an in-memory store.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Optional: require this key to view /stats.
# STATS_KEY=
